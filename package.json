{
  "name": "hacker-news-fa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that turns high-value Hacker News stories into natural Persian posts for Telegram, powered by Gemini.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.165.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
