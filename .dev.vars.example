# Copy this file to `.dev.vars` for local development with `wrangler dev`.
# `.dev.vars` is git-ignored and must never be committed.
#
# In production these are set with `wrangler secret put <NAME>` instead.

# Telegram bot token from @BotFather, e.g. 123456789:AAH...
TELEGRAM_BOT_TOKEN="123456789:replace-me"

# Channel username (e.g. @my_channel) or numeric id (e.g. -1001234567890).
# The bot must be an administrator with permission to post messages.
TELEGRAM_CHANNEL_ID="@my_channel"

# Google AI Studio API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="replace-me"

# Long random string used to protect GET /trigger.
# Generate one with: openssl rand -hex 32
TRIGGER_SECRET="replace-me-with-a-long-random-secret"

# Optional local overrides (the deployed values live in wrangler.toml):
# GEMINI_MODEL="gemini-3.5-flash-lite"
# MIN_SCORE="100"
# MAX_POSTS_PER_RUN="2"
# MAX_STORIES_TO_SCAN="30"
# MAX_COMMENTS="5"
# TELEGRAM_CHANNEL_HANDLE="@AutoHackerNewsFarsi"
# GEMINI_THINKING_BUDGET="0"
